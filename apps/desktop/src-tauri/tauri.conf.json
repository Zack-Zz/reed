{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reed",
  "version": "0.1.0",
  "identifier": "dev.reed.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Reed", "width": 1120, "height": 760, "minWidth": 760, "minHeight": 560 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main"]
    }
  },
  "bundle": { "active": false }
}
