# Rust build and diagnostic output; Cargo.lock is intentionally not ignored.
/target/
**/target/
**/*.rs.bk
*.pdb
**/mutants.out*/
rustc-ice-*.txt

# JavaScript and frontend build output.
**/node_modules/
**/dist/
**/.vite/
**/coverage/
*.tsbuildinfo

# Local environment, credentials and runtime data. Sanitized examples may be tracked.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.log
/profiles/
/.reed-local/
/.local/
/backups/
/artifacts/

# Machine-local and temporary output.
.DS_Store
Thumbs.db
.idea/
*.swp
*.tmp

# Generated native permissions/schemas and Python check caches.
/apps/desktop/src-tauri/gen/
/apps/desktop/src-tauri/permissions/autogenerated/
**/__pycache__/
